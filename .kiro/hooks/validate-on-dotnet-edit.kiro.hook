{
  "enabled": true,
  "name": "Compile Check on .NET Edit",
  "description": "Runs dotnet build when C# or project files are saved during migration",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.cs",
      "*.csproj"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "dotnet build --nologo -v q"
  }
}