{
  "enabled": true,
  "name": "SonarQube Credential Prompt",
  "description": "At Phase 7 start, ensures the agent prompts the user for SonarQube URL and token before proceeding with the mandatory scan",
  "version": "1",
  "when": {
    "type": "preTaskExecution"
  },
  "then": {
    "type": "askAgent",
    "prompt": "CHECK: If the current migration phase is 7 (Quality Gate), you MUST ask the user for their SonarQube credentials before doing anything else in this phase. Ask for: 1. SonarQube Server URL (e.g., https://sonarqube-hub.azurewebsites.net) 2. SonarQube Authentication Token. Do NOT proceed with the scan until the user provides both values. Do NOT use any previously stored or hardcoded values. Do NOT skip this step or mark Phase 7 as pending/indeterminate. If the current phase is NOT 7, proceed normally."
  }
}