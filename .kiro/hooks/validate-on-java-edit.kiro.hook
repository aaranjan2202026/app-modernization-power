{
  "enabled": true,
  "name": "Compile Check on Java Edit",
  "description": "Runs Maven compilation check when Java files are saved to catch errors early during migration",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.java",
      "pom.xml"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "mvn compile -f Hospital_Servlet1/pom.xml -q 2>&1 | head -20"
  }
}