@model PharmacyNetwork.Web.ViewModels.IncomeDetailViewModel

@{
    ViewData["Title"] = "Income Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-3 text-center">Income Details</h2>

<h3 class="mb-3 mt-3">@Html.DisplayFor(model => model.Income.Pharm.PharmName)</h3>

<div>
    <dl class="row justify-content-center">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Income.IncomeId)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Income.IncomeId)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Income.IncomeDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Income.IncomeDate)
        </dd>
    </dl>
</div>

<link href="~/lib/bootstrap-table/dist/bootstrap-table.min.css" rel="stylesheet">

<h5 class="mb-3 mt-3 text-center">List of Medical Items in Income</h5>

<div class="table-responsive">
    <table data-toggle="table"
           data-filter-control="true"
           data-classes="table table-hover"
           data-pagination="true"
           data-pagination-loop="false"
           data-page-list="[3, 10, 25, 50, 100, 200, All]"
           data-locale="en-US">
        <thead>
            <tr>
                <th scope="col" data-sortable="true" data-field="medItem">
                    Medical Item
                </th>
                <th scope="col" data-sortable="true" data-field="medItemPrice">
                    Price per Unit
                </th>
                <th scope="col" data-sortable="true" data-field="count">
                    Quantity
                </th>
                <th scope="col" data-sortable="true" data-field="price">
                    Total
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.IncomeDetails)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.MedItem.MedItemName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.MedItem.MedItemPrice)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Count)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Price) UAH
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div>
    <a asp-action="Index" class="mt-3 btn btn-secondary btn-lg">Back</a>
</div>

@section Scripts {
    <script src="~/lib/bootstrap-table/dist/bootstrap-table.min.js"></script>
    <script src="~/lib/bootstrap-table/dist/bootstrap-table-locale-all.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js" integrity="sha384-UO2eT0CpHqdSJQ6hJty5KVphtPhzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1" crossorigin="anonymous"></script>
}