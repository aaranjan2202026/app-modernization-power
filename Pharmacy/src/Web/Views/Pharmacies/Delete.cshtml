@model PharmacyNetwork.ApplicationCore.Entities.Pharmacy

@{
    ViewData["Title"] = "Delete Pharmacy";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="mb-3 text-center">Delete Pharmacy</h1>

<h4 class="mb-3">Are you sure you want to delete this pharmacy from the database?</h4>

@if (ViewData["DeleteError"] != null)
{
    <div class="alert alert-warning">
        <strong>Pharmacy in use:</strong> @ViewData["DeleteError"]
    </div>
}

<div>
    <dl class="row justify-content-center">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PharmName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PharmName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PharmAddress)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PharmAddress)
        </dd>
    </dl>

    <form asp-action="Delete" method="post" class="mt-3">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="PharmId" />
        <input type="submit" value="Delete" class="btn btn-danger btn-lg" /> |
        <a asp-action="Index" class="btn btn-secondary btn-lg">Back</a>
    </form>
</div>
